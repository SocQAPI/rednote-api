            "type": "string",
            "minLength": 1,
            "description": "A public Rednote profile URL or xhslink.com/xhslink.cn share link."
          },
          "user_id": {
            "type": "string",
            "minLength": 1,
            "description": "A 24-character internal Rednote user ID, not a nickname or Rednote number.",
            "pattern": "^[0-9a-fA-F]{24}$"
          }
        },
        "required": [],
        "anyOf": [
          {
            "required": [
              "url"
            ]
          },
          {
            "required": [
              "user_id"
            ]
          }
        ],
        "allOf": [
          {
            "not": {
              "required": [
                "url",
                "user_id"
              ]
            }
          }
        ]
      }

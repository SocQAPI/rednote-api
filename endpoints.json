{
  "schemaVersion": 1,
  "platform": "rednote",
  "platformName": "Rednote (Xiaohongshu)",
  "baseUrl": "https://api.socq.ai",
  "creditUsd": 0.005,
  "endpoints": [
    {
      "publicId": "rednote/comment-replies",
      "name": "Rednote Comment Replies API",
      "description": "Collect one page of public replies beneath a known Rednote comment, returning normalized reply text, author context, thread relationships, timestamps, and visible metrics when available.",
      "method": "POST",
      "path": "/v1/rednote/comment-replies",
      "payload": "payloads/comment-replies.json",
      "launchedAt": "2026-08-18",
      "price": "1 credit ($0.005) per call",
      "billing": {
        "baseCredits": 1,
        "mode": "fixed"
      },
      "docsUrl": "https://docs.socq.ai/api-manual/rednote/comment-replies",
      "landingUrl": "https://socq.ai/apis/rednote/comment-replies",
      "required": [
        "comment_id",
        "url"
      ],
      "requiredAnyOf": [],
      "mutuallyExclusive": [],
      "requestSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "comment_id": {
            "type": "string",
            "minLength": 1,
            "description": "A public comment identifier."
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "description": "A public content or product URL."
          }
        },
        "required": [
          "comment_id",
          "url"
        ]
      }
    },
    {
      "publicId": "rednote/home-recommendations",
      "name": "Rednote Home Recommendations API",
      "description": "Collect one public Rednote home recommendation page without a seed query, then read normalized post, author, media, engagement, and collection-time fields.",
      "method": "POST",
      "path": "/v1/rednote/home-recommendations",
      "payload": "payloads/home-recommendations.json",
      "launchedAt": "2026-08-17",

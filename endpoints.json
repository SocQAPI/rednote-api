      "publicId": "rednote/user-notes",
      "name": "Rednote User Notes API",
      "description": "Collect one page of public Rednote notes from a supported user URL or user ID, returning normalized text, authors, media, timestamps, and visible engagement.",
      "method": "POST",
      "path": "/v1/rednote/user-notes",
      "payload": "payloads/user-notes.json",
      "launchedAt": "2026-08-17",
